# ==========================================
# 1. Application Settings (FastAPI & Server)
# ==========================================
PROJECT_NAME="FastAPI Clean Architecture Demo"
ENVIRONMENT="development"  # development, staging, production
DEBUG=True
PORT=8000
HOST="0.0.0.0"
API_V1_STR="/api/v1"
VERSION=0.0.1

# ==========================================
# 2. Database Settings (MongoDB / Motor)
# ==========================================
# รูปแบบ Connection String สำหรับ MongoDB Atlas หรือ Local
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="real_estate_db"

# ==========================================
# 3. LLM & AI Services (Google Gemini / LangChain)
# ==========================================
# API Key สำหรับ Google Gemini 1.5 Flash (Free Tier 100%)
GOOGLE_API_KEY="AIzaSy..."

# กำหนดรุ่น Model ตาม Architecture
LLM_MODEL_NAME="gemini-1.5-flash"
EMBEDDING_MODEL_NAME="models/text-embedding-004"

# LangChain Settings
LANGCHAIN_TRACING_V2="false"  # ตั้งเป็น true หากต้องการทำ LLM Audit Trail บน LangSmith
LANGCHAIN_API_KEY=""

# ==========================================
# 4. GCP & Deployment Configurations
# ==========================================
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="asia-southeast1"